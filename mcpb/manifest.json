{
  "manifest_version": "0.2",
  "name": "mixx-dj-mcp",
  "version": "0.2.0",
  "description": "FastMCP server for Mixxx DJ software control via OSC protocol",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "health_check", "description": "health_check" },
    { "name": "diagnostics", "description": "diagnostics" },
    { "name": "deck_status", "description": "deck_status" },
    { "name": "library_plex_libraries", "description": "List Plex libraries from plex-mcp (for filter dropdowns)." },
    { "name": "library_search", "description": "Search via plex-mcp (filters, metadata, semantic) with Mixxx SQLite fallback." },
    { "name": "library_resolve", "description": "Resolve plex:rating_key to a local file path for deck load." },
    { "name": "library_artwork_plex", "description": "Proxy Plex thumb/poster art through mixx-dj-mcp (same-origin for the webapp)." },
    { "name": "library_artwork_calibre", "description": "Proxy Calibre book cover through mixx-dj-mcp." },
    { "name": "sfx_status", "description": "sfx-mcp connectivity and FreeSound API key status." },
    { "name": "sfx_search_route", "description": "Search FreeSound via sfx-mcp." },
    { "name": "sfx_download_route", "description": "Download a sound through sfx-mcp to local cache." },
    { "name": "sfx_local_route", "description": "List locally cached sfx-mcp sounds." },
    { "name": "list_skins", "description": "Curated skin manifest with install state for the Skins webapp page." },
    { "name": "tools_call", "description": "Invoke a registered MCP tool from the webapp or scripts." },
    { "name": "effects_action", "description": "Apply an effect rack operation via mixx_effects." },
    { "name": "music_generate", "description": "Generate music - tries: Lyria (Vertex AI) → MusicGen (local) → songgeneration-mcp." },
    { "name": "llm_discover", "description": "Detect local LLM provider(s)." },
    { "name": "fork_info", "description": "Detect whether connected DJ software is mixxxxx (video fork) or vanilla Mixxx." },
    { "name": "engine_capabilities", "description": "Full feature matrix for webapp gating (Mixxx vs mixxxxx, OSC state)." },
    { "name": "api_settings", "description": "api_settings" },
    { "name": "api_settings_update", "description": "api_settings_update" },
    { "name": "mixxx_first_run_setup", "description": "First-run checklist for users: install → launch → OSC." },
    { "name": "library_serato_status", "description": "List Serato Subcrates if present (no Serato app required - reads filesystem)." },
    { "name": "mixxx_detect", "description": "mixxx_detect" },
    { "name": "mixxx_status", "description": "mixxx_status" },
    { "name": "api_osc_ports", "description": "UDP bind check for MCP listen + Mixxx command ports." },
    { "name": "mixxx_launch", "description": "mixxx_launch" },
    { "name": "mixxx_probe", "description": "mixxx_probe" },
    { "name": "deck_load", "description": "deck_load" },
    { "name": "deck_play_pause", "description": "deck_play_pause" },
    { "name": "deck_sync", "description": "deck_sync" },
    { "name": "llm_chat", "description": "Chat endpoint - executes commands via OSC, falls back to Ollama." },
    { "name": "deck_cue", "description": "deck_cue" },
    { "name": "fleet_sources", "description": "List registered external audio sources (songgen, sfx, stems, plex, etc.)." },
    { "name": "fleet_register", "description": "Register an external audio source for deck handoff." },
    { "name": "cockpit_now_playing", "description": "Aggregated 'what's happening' across all decks and connected sources." },
    { "name": "voice_command", "description": "Webhook for speech-mcp voice commands." },
    { "name": "mixx_ai_set", "description": "mixx_ai_set" },
    { "name": "mixx_ai_set_plan", "description": "mixx_ai_set(plan)" },
    { "name": "mixx_ai_set_suggest_next", "description": "mixx_ai_set(suggest_next)" },
    { "name": "mixx_ai_set_perform_transition", "description": "mixx_ai_set(perform_transition)" },
    { "name": "mixx_ai_set_review_set", "description": "mixx_ai_set(review_set)" },
    { "name": "mixx_analyze", "description": "mixx_analyze" },
    { "name": "_check_librosa_track", "description": "_check_librosa(track)" },
    { "name": "_check_librosa_batch_status", "description": "_check_librosa(batch_status)" },
    { "name": "_check_librosa_suggest_cues", "description": "_check_librosa(suggest_cues)" },
    { "name": "mixx_controller", "description": "mixx_controller" },
    { "name": "_get_mixxx_controllers_dir_detect", "description": "_get_mixxx_controllers_dir(detect)" },
    { "name": "_get_mixxx_controllers_dir_install", "description": "_get_mixxx_controllers_dir(install)" },
    { "name": "_get_mixxx_controllers_dir_list", "description": "_get_mixxx_controllers_dir(list)" },
    { "name": "_get_mixxx_controllers_dir_status", "description": "_get_mixxx_controllers_dir(status)" },
    { "name": "_get_mixxx_controllers_dir_download", "description": "_get_mixxx_controllers_dir(download)" },
    { "name": "mixx_daw", "description": "mixx_daw" },
    { "name": "mixx_deck", "description": "mixx_deck" },
    { "name": "mixx_effects", "description": "mixx_effects" },
    { "name": "mixx_history", "description": "mixx_history" },
    { "name": "mixx_history_plays", "description": "mixx_history(plays)" },
    { "name": "mixx_history_transitions", "description": "mixx_history(transitions)" },
    { "name": "mixx_history_profile", "description": "mixx_history(profile)" },
    { "name": "mixx_history_suggest", "description": "mixx_history(suggest)" },
    { "name": "mixx_history_log_play", "description": "mixx_history(log_play)" },
    { "name": "mixx_history_log_transition", "description": "mixx_history(log_transition)" },
    { "name": "mixx_library", "description": "mixx_library" },
    { "name": "mixx_mixer", "description": "mixx_mixer" },
    { "name": "mixx_mixer_high", "description": "mixx_mixer(high)" },
    { "name": "mixx_mixer_mid", "description": "mixx_mixer(mid)" },
    { "name": "mixx_mixer_low", "description": "mixx_mixer(low)" },
    { "name": "show_deck_status_card", "description": "show_deck_status_card" },
    { "name": "show_mixer_status_card", "description": "show_mixer_status_card" },
    { "name": "show_library_status_card", "description": "show_library_status_card" },
    { "name": "mixx_recording", "description": "mixx_recording" },
    { "name": "_get_sets_dir_start", "description": "_get_sets_dir(start)" },
    { "name": "_get_sets_dir_stop", "description": "_get_sets_dir(stop)" },
    { "name": "_get_sets_dir_list", "description": "_get_sets_dir(list)" },
    { "name": "_get_sets_dir_replay", "description": "_get_sets_dir(replay)" },
    { "name": "_get_sets_dir_export", "description": "_get_sets_dir(export)" },
    { "name": "_get_sets_dir_status", "description": "_get_sets_dir(status)" },
    { "name": "mixx_set", "description": "mixx_set" },
    { "name": "_get_mixxx_db_path_sequence", "description": "_get_mixxx_db_path(sequence)" },
    { "name": "_get_mixxx_db_path_record", "description": "_get_mixxx_db_path(record)" },
    { "name": "_get_mixxx_db_path_analyze_set", "description": "_get_mixxx_db_path(analyze_set)" },
    { "name": "mixx_skin", "description": "mixx_skin" },
    { "name": "mixx_crate", "description": "mixx_crate" },
    { "name": "register_crate_tools_create", "description": "register_crate_tools(create)" },
    { "name": "register_crate_tools_list", "description": "register_crate_tools(list)" },
    { "name": "register_crate_tools_delete", "description": "register_crate_tools(delete)" },
    { "name": "register_crate_tools_add_track", "description": "register_crate_tools(add_track)" },
    { "name": "register_crate_tools_create_agentic", "description": "register_crate_tools(create_agentic)" },
    { "name": "mixx_stems", "description": "mixx_stems" },
    { "name": "_check_demucs_separate", "description": "_check_demucs(separate)" },
    { "name": "_check_demucs_status", "description": "_check_demucs(status)" },
    { "name": "_check_demucs_load_stems", "description": "_check_demucs(load_stems)" },
    { "name": "_check_demucs_transition", "description": "_check_demucs(transition)" },
    { "name": "_check_demucs_mute", "description": "_check_demucs(mute)" },
    { "name": "_check_demucs_volume", "description": "_check_demucs(volume)" },
    { "name": "mixx_transition", "description": "mixx_transition" },
    { "name": "_llm_pick_transition_suggest", "description": "_llm_pick_transition(suggest)" },
    { "name": "_llm_pick_transition_apply", "description": "_llm_pick_transition(apply)" },
    { "name": "_llm_pick_transition_auto_crossfader", "description": "_llm_pick_transition(auto_crossfader)" },
    { "name": "mixx_vinyl", "description": "mixx_vinyl" },
    { "name": "_get_conn_catalog", "description": "_get_conn(catalog)" },
    { "name": "_get_conn_search", "description": "_get_conn(search)" },
    { "name": "_get_conn_gig_pick", "description": "_get_conn(gig_pick)" },
    { "name": "_get_conn_crossref", "description": "_get_conn(crossref)" },
    { "name": "_get_conn_stats", "description": "_get_conn(stats)" }
  ]
}