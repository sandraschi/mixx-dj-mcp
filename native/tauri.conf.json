{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixx-DJ-MCP",
  "version": "0.1.0",
  "identifier": "ai.fleet.mixx-dj-mcp",
  "build": {
    "frontendDist": "../web_sota/dist",
    "devUrl": "http://localhost:11117",
    "beforeBuildCommand": "pwsh -NoProfile -File ./build.ps1"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mixx DJ MCP",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": [
      "resources/mixx-dj-mcp-backend.exe",
      "resources/.env.example",
      "../scripts/install-mcp-clients.ps1"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
