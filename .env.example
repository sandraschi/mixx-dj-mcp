# Mixx-DJ-MCP Configuration
# Copy to .env and edit for your setup

# Server
MIXX_MCP_HOST=127.0.0.1
MIXX_MCP_PORT=11116

# OSC ports (must match Mixxx Preferences → MIDI/OSC)
MIXX_OSC_OUT_PORT=11118
MIXX_OSC_IN_PORT=11119

# Mixxx host (OSC target)
MIXX_HOST=127.0.0.1

# Optional: explicit paths (auto-detected if unset)
# MIXXXXX_EXE=D:\Dev\repos\mixxxxx\build\mixxx.exe
# MIXXX_EXE=C:\Program Files\Mixxx\mixxx.exe

# plex-mcp (intelligent library search, metadata, filters)
PLEX_MCP_URL=http://127.0.0.1:10740

# Optional: Serato Subcrates folder (when Serato not installed, leave unset)
# SERATO_SUBCRATES_DIR=C:\Users\Dani\Music\_Serato_\Subcrates

# calibre-mcp (book cover proxy for ebook results)
CALIBRE_MCP_URL=http://127.0.0.1:10720

# sfx-mcp (FreeSound search + local cache)
SFX_MCP_URL=http://127.0.0.1:11120

# Logging
LOG_LEVEL=info

# Set to 1 when running inside Tauri WebView
MIXX_TAURI=0
