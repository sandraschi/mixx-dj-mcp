# Mixx-DJ-MCP Configuration
# Copy to .env and edit for your setup

# Server
MIXX_MCP_HOST=127.0.0.1
MIXX_MCP_PORT=11116

# OSC ports (must match Mixxx Preferences → MIDI/OSC)
MIXX_OSC_OUT_PORT=11118
MIXX_OSC_IN_PORT=11119

# Mixxx host
MIXX_HOST=127.0.0.1

# plex-mcp (intelligent library search, metadata, filters)
PLEX_MCP_URL=http://127.0.0.1:10740

# Logging
LOG_LEVEL=info

# Set to 1 when running inside Tauri WebView
MIXX_TAURI=0
